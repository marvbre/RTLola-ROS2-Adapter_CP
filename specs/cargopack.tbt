// gesture_state codes (see cargo_drone_pkg/rtlola_translator.py's GESTURE_STATE_MAP,
// itself mirroring gimbal_fsm.py's GimbalFSM states and their "gesture: X" comments):
//   0 BLIND   1 SEARCH  2 APPROACH  3 WAITING_FOR_USER  4 IDLE
//   5 FOLLOW_USER (gesture: Greet)      6 SELECTION (gesture: Point)
//   7 PROXY_CONTROL (gesture: Proxy)    8 CANCEL_MOVEMENT (gesture: Stop)
//   9 TAKE_OFF (gesture: Takeoff)       10 TARGET_POSITION (neutral-gesture exit)
//   11 UNKNOWN (unmapped state string)
// TODO(colleague): confirm this mapping - inferred from gimbal_fsm.py's state
// comments, not yet confirmed against your intent for this TBT.

c_collision_radius = 10.0;
c_gesture_greet = 5;
c_gesture_takeoff = 9;
c_takeoff_altitude = 1.0;
c_gesture_point = 6;
c_gesture_proxy = 7;
c_proxy_alimit = 1.0;
c_gesture_stop = 8;
c_gesture_exit = 10;

=> 2 (
    'avoid_collision' [] no_collision(x,y,z) [ !sqrt(x^2.0 + y^2.0 + z^2.0) > c_collision_radius],
    * -> (
            'greet' <> a_greet(gesture_state, operator_id) [ !min(gesture_state == c_gesture_greet, operator_id != -1) ],
            'takeoff' <> a_takeoff(gesture_state, z) [ !min(gesture_state == c_gesture_takeoff, z > c_takeoff_altitude)],
            * ? (
                -> (
                    'point' <> a_point(gesture_state) [ gesture_state == c_gesture_point],
                    => 2 (
                        'point_geofence' [] a_point_in_geofence(tx, ty, tz) [ !sqrt(tx^2.0 + ty^2.0 + tz^2.0) < c_collision_radius ],
                        'vel_direction'  <0..4> a_towards_target(tx, ty, tz, x, y, z, u, v, w) [ (tx - x) * u + (ty - y) * v + (tz - z) * w > 0.0 ]
                    )
                ),
                -> (
                    'start_proxy' <> a_proxy(gesture_state) [ gesture_state == c_gesture_proxy ],
                    => 2 (
                        'in_proxy' [] a_state_proxy(gesture_state) [ gesture_state == c_gesture_proxy ],
                        'vel_direction'  [] a_vel_direction(u,v,w) [ !sqrt(u^2.0 + v^2.0 + w^2.0) < c_proxy_alimit]
                    ),
                    'stop'  <> a_stop_proxy(gesture_state) [ gesture_state == c_gesture_stop ]
                )
            ),
            'exit' <> a_exit(gesture_state) [ gesture_state == c_gesture_exit ]
        )
)



/* 

output file mit separatem stream fuer seinen leaf node

input localstate_x : Float64
input localstate_y : Float64
input localstate_z : Float64
input localstate_u : Float64
input localstate_v : Float64
input localstate_w : Float64

input targetposition_tx : Float64
input targetposition_ty : Float64
input targetposition_tz : Float64

input operatorstatus_gesture_state : UInt32
input operatorstatus_operator_id : Int32

trigger operatorstatus_gesture_state == 0  "ok"
trigger operatorstatus_gesture_state != 0  "nook"

output valid_node_transitions := operatorstatus_operator_id == 3
*/