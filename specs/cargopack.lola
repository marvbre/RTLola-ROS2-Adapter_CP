  close when !leaf_17

trigger spawn when leaf_17
  eval when tl_change_leaf_17 and tl_outcome_17 == 1 with "Presumably satisfied Leaf node 17"
  close when !leaf_17

trigger spawn when leaf_17
  eval when tl_change_leaf_17 and tl_outcome_17 == -1 with "Presumably violated Leaf node 17"
