  close when !leaf_4

//  ap10 || X ap10 || XX ap10 || XXX ap10 || XXXX ap10
output tl_transition_5 : UInt
  spawn when leaf_5
  eval with if tl_transition_5.offset(by: -1).defaults(to: 3) == 6 and (ap10<0.0) then 1 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 4 and (ap10>0.0) then 0 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 3 and (ap10<0.0) then 2 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 2 and (ap10<0.0) then 4 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 0 and (ap10>0.0) then 0 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 6 and (ap10>0.0) then 0 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 3 and (ap10>0.0) then 0 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 1 and (ap10<0.0) then 5 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 4 and (ap10<0.0) then 6 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 2 and (ap10>0.0) then 0 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 1 and (ap10>0.0) then 0 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 5 and (ap10>0.0) then 5 else
               tl_transition_5.offset(by: -1).defaults(to: 3)
  close when !leaf_5

output tl_outcome_5 : Int
  spawn when leaf_5
  eval with if tl_transition_5.offset(by: -1).defaults(to: 3) == 6 and tl_transition_5 == 1 then -1 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 4 and tl_transition_5 == 0 then 2 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 3 and tl_transition_5 == 2 then -1 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 2 and tl_transition_5 == 4 then -1 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 0 and tl_transition_5 == 0 then 2 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 6 and tl_transition_5 == 0 then 2 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 3 and tl_transition_5 == 0 then 2 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 1 and tl_transition_5 == 5 then -2 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 4 and tl_transition_5 == 6 then -1 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 2 and tl_transition_5 == 0 then 2 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 1 and tl_transition_5 == 0 then 2 else
            if tl_transition_5.offset(by: -1).defaults(to: 3) == 5 and tl_transition_5 == 5 then -2 else
               tl_outcome_5.offset(by: -1).defaults(to: 3)
  close when !leaf_5

output tl_change_leaf_5
  spawn when leaf_5
  eval with tl_outcome_5.offset(by: -1).defaults(to: 0) != tl_outcome_5
  close when !leaf_5

trigger spawn when leaf_5
