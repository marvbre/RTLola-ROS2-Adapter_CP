            if tl_transition_12.offset(by: -1).defaults(to: 1) == 0 and tl_transition_12 == 0 then 2 else
               tl_outcome_12.offset(by: -1).defaults(to: 1)
  close when !leaf_12

output tl_change_leaf_12
  spawn when leaf_12
  eval with tl_outcome_12.offset(by: -1).defaults(to: 0) != tl_outcome_12
  close when !leaf_12

trigger spawn when leaf_12
  eval when tl_change_leaf_12 and tl_outcome_12 == 2 with "Satisfied Leaf node 12"
  close when !leaf_12

trigger spawn when leaf_12
  eval when tl_change_leaf_12 and tl_outcome_12 == 1 with "Presumably satisfied Leaf node 12"
  close when !leaf_12

trigger spawn when leaf_12
  eval when tl_change_leaf_12 and tl_outcome_12 == -1 with "Presumably violated Leaf node 12"
  close when !leaf_12

trigger spawn when leaf_12
  eval when tl_change_leaf_12 and tl_outcome_12 == -2 with "Violated Leaf node 12"
  close when !leaf_12

// F(ap20)
output tl_transition_17 : UInt
  spawn when leaf_17
  eval with if tl_transition_17.offset(by: -1).defaults(to: 1) == 1 and (ap20<0.0) then 1 else
            if tl_transition_17.offset(by: -1).defaults(to: 1) == 1 and (ap20>0.0) then 0 else
            if tl_transition_17.offset(by: -1).defaults(to: 1) == 0 and (ap20>0.0) then 0 else
               tl_transition_17.offset(by: -1).defaults(to: 1)
  close when !leaf_17

output tl_outcome_17 : Int
  spawn when leaf_17
  eval with if tl_transition_17.offset(by: -1).defaults(to: 1) == 1 and tl_transition_17 == 1 then -1 else
            if tl_transition_17.offset(by: -1).defaults(to: 1) == 1 and tl_transition_17 == 0 then 2 else
            if tl_transition_17.offset(by: -1).defaults(to: 1) == 0 and tl_transition_17 == 0 then 2 else
               tl_outcome_17.offset(by: -1).defaults(to: 1)
  close when !leaf_17

output tl_change_leaf_17
  spawn when leaf_17
  eval with tl_outcome_17.offset(by: -1).defaults(to: 0) != tl_outcome_17
  close when !leaf_17

trigger spawn when leaf_17
