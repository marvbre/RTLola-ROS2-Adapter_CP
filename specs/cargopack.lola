  close when !leaf_1

trigger spawn when leaf_1
  eval when tl_change_leaf_1 and tl_outcome_1 == 1 with "Presumably satisfied Leaf node 1"
  close when !leaf_1

trigger spawn when leaf_1
  eval when tl_change_leaf_1 and tl_outcome_1 == -1 with "Presumably violated Leaf node 1"
  close when !leaf_1

trigger spawn when leaf_1
  eval when tl_change_leaf_1 and tl_outcome_1 == -2 with "Violated Leaf node 1"
  close when !leaf_1

// F(ap4)
output tl_transition_2 : UInt
  spawn when leaf_2
  eval with if tl_transition_2.offset(by: -1).defaults(to: 1) == 1 and (ap4<0.0) then 1 else
            if tl_transition_2.offset(by: -1).defaults(to: 1) == 1 and (ap4>0.0) then 0 else
            if tl_transition_2.offset(by: -1).defaults(to: 1) == 0 and (ap4>0.0) then 0 else
