import math

input localstate_x : Float64
input localstate_y : Float64
input localstate_z : Float64
input localstate_u : Float64
input localstate_v : Float64
input localstate_w : Float64

input targetposition_tx : Float64
input targetposition_ty : Float64
input targetposition_tz : Float64

input operatorstatus_gesture_state : UInt32
input operatorstatus_operator_id : Int32

// cargo_drone_pkg's BTLeafState (one bool per cargopack.tbt leaf, index order fixed in
// rtlola_translator.py's LEAVES), as flat fields btleafstate_active_0 .. btleafstate_active_10.
// Index -> leaf:
//  0 avoid_collision   1 greet        2 takeoff             3 point
//  4 point_geofence    5 vel_direction_point   6 start_proxy   7 in_proxy
//  8 vel_direction_proxy   9 stop     10 exit
input btleafstate_active_0 : Bool
input btleafstate_active_1 : Bool
input btleafstate_active_2 : Bool
input btleafstate_active_3 : Bool
input btleafstate_active_4 : Bool
input btleafstate_active_5 : Bool
input btleafstate_active_6 : Bool
input btleafstate_active_7 : Bool
input btleafstate_active_8 : Bool
input btleafstate_active_9 : Bool
input btleafstate_active_10 : Bool

// Inputs
output x := localstate_x
output y := localstate_y
output z := localstate_z
output u := localstate_u
output v := localstate_v
output w := localstate_w
output tx := targetposition_tx
output ty := targetposition_ty
output tz := targetposition_tz
output gesture_state := operatorstatus_gesture_state
output operator_id := operatorstatus_operator_id

// AtomicPropositions
output ap16 : Float64 := (if sqrt((((u ** 2.00) + (v ** 2.00)) + (w ** 2.00))) < 1.00 then 1.0 else -1.0)
output ap2 : Float64 := min((if gesture_state == 5 then 1.0 else -1.0), (if operator_id != -1 then 1.0 else -1.0))
output ap8 : Float64 := (if sqrt((((tx ** 2.00) + (ty ** 2.00)) + (tz ** 2.00))) < 10.00 then 1.0 else -1.0)
output ap20 : Float64 := (if gesture_state == 10 then 1.0 else -1.0)
output ap4 : Float64 := min((if gesture_state == 9 then 1.0 else -1.0), (if z > 1.00 then 1.0 else -1.0))
output ap12 : Float64 := (if gesture_state == 7 then 1.0 else -1.0)
output ap14 : Float64 := (if gesture_state == 7 then 1.0 else -1.0)
output ap0 : Float64 := (if sqrt((((x ** 2.00) + (y ** 2.00)) + (z ** 2.00))) > 10.00 then 1.0 else -1.0)
output ap18 : Float64 := (if gesture_state == 8 then 1.0 else -1.0)
output ap10 : Float64 := (if ((((tx - x) * u) + ((ty - y) * v)) + ((tz - z) * w)) > 0.00 then 1.0 else -1.0)
output ap6 : Float64 := (if gesture_state == 6 then 1.0 else -1.0)

// Leaf transitions (represent which leaf node is active)
output leaf_0 := btleafstate_active_0
output leaf_1 := btleafstate_active_1
output leaf_2 := btleafstate_active_2
output leaf_3 := btleafstate_active_3
output leaf_4 := btleafstate_active_4
output leaf_5 := btleafstate_active_5
output leaf_8 := btleafstate_active_6
output leaf_9 := btleafstate_active_7
output leaf_10 := btleafstate_active_8
output leaf_12 := btleafstate_active_9
output leaf_17 := btleafstate_active_10

// Node transitions (checks if leaf activation is valid wrt TBT)
output node_transition_0: Bool := !leaf_0.offset(by:-1).defaults(to: false) or leaf_0
output node_transition_1: Bool := !leaf_1.offset(by:-1).defaults(to: false) or (leaf_2 or leaf_1)
output node_transition_2: Bool := !leaf_2.offset(by:-1).defaults(to: false) or (leaf_3 or leaf_8 or leaf_2)
output node_transition_3: Bool := !leaf_3.offset(by:-1).defaults(to: false) or (leaf_4 or leaf_5 or leaf_3)
output node_transition_4: Bool := !leaf_4.offset(by:-1).defaults(to: false) or (leaf_17 or leaf_4)
output node_transition_5: Bool := !leaf_5.offset(by:-1).defaults(to: false) or (leaf_17 or leaf_5)
output node_transition_8: Bool := !leaf_8.offset(by:-1).defaults(to: false) or (leaf_9 or leaf_10 or leaf_8)
output node_transition_9: Bool := !leaf_9.offset(by:-1).defaults(to: false) or (leaf_12 or leaf_9)
output node_transition_10: Bool := !leaf_10.offset(by:-1).defaults(to: false) or (leaf_12 or leaf_10)
output node_transition_12: Bool := !leaf_12.offset(by:-1).defaults(to: false) or (leaf_17 or leaf_12)
output node_transition_17: Bool := !leaf_17.offset(by:-1).defaults(to: false) or (leaf_3 or leaf_8 or leaf_17)
output valid_node_transitions : Bool := node_transition_0 and node_transition_1 and node_transition_2 and node_transition_3 and node_transition_4 and node_transition_5 and node_transition_8 and node_transition_9 and node_transition_10 and node_transition_12 and node_transition_17 

// TL monitors
//- tl_transtion maps from one state to the next
//- tl_outcome is the labeling fnc
//- triggers are only produces once another leaf activates
// G(ap0)
output tl_transition_0 : UInt
  spawn when leaf_0
  eval with if tl_transition_0.offset(by: -1).defaults(to: 1) == 1 and (ap0<0.0) then 0 else
            if tl_transition_0.offset(by: -1).defaults(to: 1) == 1 and (ap0>0.0) then 1 else
            if tl_transition_0.offset(by: -1).defaults(to: 1) == 0 and (ap0>0.0) then 0 else
               tl_transition_0.offset(by: -1).defaults(to: 1)
  close when !leaf_0

output tl_outcome_0 : Int
  spawn when leaf_0
  eval with if tl_transition_0.offset(by: -1).defaults(to: 1) == 1 and tl_transition_0 == 0 then -2 else
            if tl_transition_0.offset(by: -1).defaults(to: 1) == 1 and tl_transition_0 == 1 then 1 else
            if tl_transition_0.offset(by: -1).defaults(to: 1) == 0 and tl_transition_0 == 0 then -2 else
               tl_outcome_0.offset(by: -1).defaults(to: 1)
  close when !leaf_0

output tl_change_leaf_0
  spawn when leaf_0
  eval with tl_outcome_0.offset(by: -1).defaults(to: 0) != tl_outcome_0
  close when !leaf_0

trigger spawn when leaf_0
  eval when tl_change_leaf_0 and tl_outcome_0 == 2 with "Satisfied Leaf node 0"
  close when !leaf_0

trigger spawn when leaf_0
  eval when tl_change_leaf_0 and tl_outcome_0 == 1 with "Presumably satisfied Leaf node 0"
  close when !leaf_0

trigger spawn when leaf_0
  eval when tl_change_leaf_0 and tl_outcome_0 == -1 with "Presumably violated Leaf node 0"
  close when !leaf_0

trigger spawn when leaf_0
  eval when tl_change_leaf_0 and tl_outcome_0 == -2 with "Violated Leaf node 0"
  close when !leaf_0

// F(ap2)
output tl_transition_1 : UInt
  spawn when leaf_1
  eval with if tl_transition_1.offset(by: -1).defaults(to: 1) == 1 and (ap2<0.0) then 1 else
            if tl_transition_1.offset(by: -1).defaults(to: 1) == 1 and (ap2>0.0) then 0 else
            if tl_transition_1.offset(by: -1).defaults(to: 1) == 0 and (ap2>0.0) then 0 else
               tl_transition_1.offset(by: -1).defaults(to: 1)
  close when !leaf_1

output tl_outcome_1 : Int
  spawn when leaf_1
  eval with if tl_transition_1.offset(by: -1).defaults(to: 1) == 1 and tl_transition_1 == 1 then -1 else
            if tl_transition_1.offset(by: -1).defaults(to: 1) == 1 and tl_transition_1 == 0 then 2 else
            if tl_transition_1.offset(by: -1).defaults(to: 1) == 0 and tl_transition_1 == 0 then 2 else
               tl_outcome_1.offset(by: -1).defaults(to: 1)
  close when !leaf_1

output tl_change_leaf_1
  spawn when leaf_1
  eval with tl_outcome_1.offset(by: -1).defaults(to: 0) != tl_outcome_1
  close when !leaf_1

trigger spawn when leaf_1
